{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/plan-expiry",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/outbox",
      "schedule": "0 5 * * *"
    }
  ],
  "regions": [
    "bom1"
  ],
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs"
}
